# Copia este archivo a .env y rellena los valores.
# Spring Boot no carga .env solo: exporta las variables o defínelas
# en IntelliJ (Run → Edit Configurations → Environment variables).
# docker compose sí lee .env si está junto a docker-compose.yml.

DB_URL=jdbc:postgresql://localhost:5432/asistencia_escolar
DB_USER=admin_asistente
DB_PASSWORD=cambia-esta-clave

# Obligatorio. Al menos 32 caracteres.
JWT_SECRET=cambia-esta-clave-super-secreta-minimo-32-caracteres

# Solo aplica si arrancas con el perfil Spring "demo".
SEED_DATA=true
